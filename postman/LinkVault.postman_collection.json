{
  "info": {
    "name": "LinkVault API - CRUD and validation",
    "description": "Run requests in numbered order. A successful create stores bookmarkId for the following requests. Backend must be running at localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create bookmark (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"React Documentation\",\n  \"url\": \"https://react.dev\",\n  \"category\": \"Development\",\n  \"notes\": \"Created in Postman\",\n  \"favorite\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Created 201\", () => pm.response.to.have.status(201));",
              "const data=pm.response.json();",
              "pm.collectionVariables.set(\"bookmarkId\", data.id);",
              "pm.test(\"Has saved bookmark ID\", () => pm.expect(data.id).to.be.a(\"number\"));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. List bookmarks (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"List returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Get saved bookmark (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks/{{bookmarkId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks",
            "{{bookmarkId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Get bookmark returns 200\", () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Edit saved bookmark (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks/{{bookmarkId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks",
            "{{bookmarkId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"React Docs - Updated\",\n  \"url\": \"https://react.dev\",\n  \"category\": \"Learning\",\n  \"notes\": \"Edited with Postman\",\n  \"favorite\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Updated 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Title changed\", () => pm.expect(pm.response.json().title).to.eql(\"React Docs - Updated\"));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Delete saved bookmark (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks/{{bookmarkId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks",
            "{{bookmarkId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted 204\", () => pm.response.to.have.status(204));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Invalid: missing title (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"url\": \"https://react.dev\",\n  \"category\": \"Development\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Missing title returns 400\", () => pm.response.to.have.status(400));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Invalid: unsafe URL (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unsafe URL\",\n  \"url\": \"javascript:alert(1)\",\n  \"category\": \"Development\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Unsafe URL returns 400\", () => pm.response.to.have.status(400));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Deleted bookmark is gone (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/bookmarks/{{bookmarkId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookmarks",
            "{{bookmarkId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deleted bookmark returns 404\", () => pm.response.to.have.status(404));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "bookmarkId",
      "value": ""
    }
  ]
}
